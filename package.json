{
  "type": "module",
  "name": "mediqueue-backend",
  "scripts": {
    "dev": "nodemon --exec tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "migrate:up": "node-pg-migrate up --migrations-dir src/db/migrations --dotenv-config-path .env",
    "migrate:down": "node-pg-migrate down --migrations-dir src/db/migrations --dotenv-config-path .env",
    "seed-subscription-plans": "node src/db/seeds/01_subscription_plans.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.8",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "resend": "^6.28.1",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "5.9",
    "vitest": "^5.0.1"
  }
}
